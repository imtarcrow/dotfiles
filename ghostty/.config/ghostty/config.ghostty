language = de

# font-family = "CaskaydiaCove Nerd Font Mono"
# font-size = 14

# font-family = "JetBrainsMono Nerd Font Mono"
# font-size = 14

# font-family = "Iosevka Custom"
# font-size = 16

font-family = "Monaspace Neon NF"
font-size = 12

window-padding-x = 6
window-padding-y = 6
window-padding-balance = true

window-width = 132 
window-height = 44 

window-vsync = true
confirm-close-surface = false

scrollback-limit = 10000000

clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

right-click-action = ignore

shell-integration = fish
shell-integration-features = ssh-env,ssh-terminfo

keybind = ctrl+shift+1=goto_tab:1
keybind = ctrl+shift+2=goto_tab:2
keybind = ctrl+shift+3=goto_tab:3
keybind = ctrl+shift+4=goto_tab:4
keybind = ctrl+shift+5=goto_tab:5
keybind = ctrl+shift+6=goto_tab:6
keybind = ctrl+shift+7=goto_tab:7
keybind = ctrl+shift+8=goto_tab:8
keybind = ctrl+shift+9=goto_tab:9

keybind = cmd+w=ignore

custom-shader = ./shaders/cursor_warp.glsl

config-file = themes/catppuccin-gruvbox
